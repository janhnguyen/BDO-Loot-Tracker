# User Configurations
CHARACTER_NAME=YourCharacterName
DEFAULT_ZONE=Unknown

# OCR capture region (run Calibrate from Settings to set these)
REGION_LEFT_PCT=0.0581
REGION_TOP_PCT=0.5056
REGION_RIGHT_PCT=0.1343
REGION_BOTTOM_PCT=0.8424

# Settings (managed via Settings panel)
SHOW_OCR_LOG=false
TRACKING_WINDOW_SIZE=20
ITEMS_FONT_SIZE=12
SESSION_RESET_DELAY_SECONDS=1.5
SHOW_LIVE_LOG=false
SHOW_OCR_PANE=false

KEYBIND_START=Control+Shift+A
KEYBIND_PAUSE=Control+Shift+S
KEYBIND_STOP=Control+Shift+D
