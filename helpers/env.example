# User
CHARACTER_NAME=YourFamilyName
DEFAULT_ZONE=Unknown

# OCR capture region (run Calibrate from Settings to set these)
REGION_LEFT_PCT=0
REGION_TOP_PCT=0
REGION_RIGHT_PCT=0
REGION_BOTTOM_PCT=0

# Tracking
TRACKING_WINDOW_SIZE=20
SESSION_RESET_DELAY_SECONDS=1.5

# Advanced pipeline tuning
OCR_UPSCALE=2.0
LOOT_MIN_SIGHTINGS=3
NAME_FUZZY_THRESHOLD=0.82
ENABLE_STABILITY_GATE=true
STABILITY_DIFF_THRESHOLD=3.0
STABILITY_MIN_FRAMES=2
ENABLE_SCROLL_HINT=true
MAX_PLAUSIBLE_NEW=10
METRICS_LOG_INTERVAL_SECONDS=30

# Display (managed via the Settings panel)
ITEMS_FONT_SIZE=12
SHOW_LIVE_LOG=false
SHOW_OCR_LOG=false
SHOW_OCR_PANE=false
SHOW_SYSTEM_MESSAGES=true

# Keybinds
KEYBIND_START=Control+Shift+A
KEYBIND_PAUSE=Control+Shift+S
KEYBIND_STOP=Control+Shift+D

# Window 
WINDOW_WIDTH=520
WINDOW_HEIGHT=760
